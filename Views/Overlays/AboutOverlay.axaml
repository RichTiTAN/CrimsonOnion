<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="460"
             x:Class="CrimsonOnion.Views.Overlays.AboutOverlay">
<Grid>
    <ScrollViewer>
        <StackPanel Margin="20,20,20,20" Spacing="20">

            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <Image Source="avares://CrimsonOnion/Assets/icon.ico" Width="40" Height="40" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CrimsonOnion" FontSize="20" FontWeight="Bold" Foreground="#E2E8F0"/>
                        <TextBlock x:Name="lblAboutCreator" Text="Creator: @RichTitan" FontSize="12" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,2,0,0"/>
                        <TextBlock x:Name="lblAboutLicense" Text="License: GPL-3.0 license" FontSize="11" FontWeight="Normal" Foreground="#A0AEC0" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0">
                    <Button Click="BtnGithub_Click" Classes="optBtn" Background="#101112" BorderBrush="#2D3748" BorderThickness="1" Padding="10">
                        <PathIcon Data="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.009-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z" Width="16" Height="16" Foreground="#8B949E"/>
                    </Button>
                    <Button Click="BtnTelegram_Click" Classes="optBtn" Background="#101112" BorderBrush="#2D3748" BorderThickness="1" Padding="10">
                        <PathIcon Data="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.892-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z" Width="16" Height="16" Foreground="#8B949E"/>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
                <Border Background="#101112" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="15,0" Height="45">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" Width="14" Height="14" Foreground="#8B949E"/>
                        <TextBlock x:Name="lblAboutVersion" Text="VERSION" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="btnCheckUpdate" Grid.Column="1" Content="CHECK FOR UPDATES" Click="BtnCheckUpdate_Click" FontSize="11" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource ThemeGlowBrush}" Padding="5" Cursor="Hand" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblVersion" Grid.Column="2" Text="2.0.0" FontSize="14" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="#101112" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="15,0" Height="45">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" Width="14" Height="14" Foreground="#8B949E"/>
                        <TextBlock x:Name="lblOtherApps" Text="OTHER APPS" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Click="BtnOtherApps_Click" Background="Transparent" BorderThickness="0" Padding="5" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Source="avares://CrimsonOnion/Assets/CrimsonX.ico" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                            <TextBlock Text="CrimsonX" FontSize="13" FontWeight="Bold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Spacing="0">
                <Border x:Name="panDonationsToggle" Background="#101112" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="0" Height="45">
                    <Button x:Name="btnDonationsToggle" Classes="optBtn" CornerRadius="8" BorderThickness="0" Background="Transparent" Padding="12,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="btnDonationsToggle_Click">
                        <Grid ColumnDefinitions="*, Auto" MinHeight="36">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" Width="14" Height="14" Foreground="#8B949E"/>
                                <TextBlock x:Name="lblDonations" Text="DONATIONS" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblDonationsDesc" Text="Donations are only available through Crypto wallets due to privacy reasons." FontSize="9" FontWeight="Normal" Foreground="#A0AEC0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="350" Margin="5,0,0,0"/>
                            </StackPanel>
                            <PathIcon x:Name="icoDonationsExpander" Grid.Column="1" Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" Width="12" Height="12" Foreground="#8B949E" VerticalAlignment="Center" Margin="10,0,0,0">
                                <PathIcon.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="RotateTransform.Angle" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    </Transitions>
                                </PathIcon.Transitions>
                            </PathIcon>
                        </Grid>
                    </Button>
                </Border>
                <Border x:Name="panDonations" Background="#0A0B0E" BorderBrush="#2D3748" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" MaxHeight="0" Opacity="0" ClipToBounds="True">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="8" Margin="15,15,15,15">
                        <StackPanel Spacing="2">
                            <TextBlock Text="USDT (BEP20)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <Button Click="BtnCopyAddress_Click" Content="0xFc1d71C22DC2604f6C13Ca540ed842535cbE6d75" FontSize="10" FontWeight="Normal" Foreground="#E2E8F0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="USDT (TRC20)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <Button Click="BtnCopyAddress_Click" Content="TNMaNGDMG7BzbjkXeiguFWzDHZ4hCUU9R8" FontSize="10" FontWeight="Normal" Foreground="#E2E8F0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="BITCOIN" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <Button Click="BtnCopyAddress_Click" Content="bc1quzdzuhrfse520r0wkqgkvsl7nv354r8sj5u9f9" FontSize="10" FontWeight="Normal" Foreground="#E2E8F0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="TON (GRAM)" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E"/>
                            <Button Click="BtnCopyAddress_Click" Content="UQCB3bvk4nXMiokNWprb7CwPjurU8WOUfVSgAVXMMke0CxdW" FontSize="10" FontWeight="Normal" Foreground="#E2E8F0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

    <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseOverlay_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="5" Margin="0,8,8,0">
        <Button.Styles>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
            <Style Selector="Button:pointerover PathIcon">
                <Setter Property="Foreground" Value="#E2E8F0"/>
            </Style>
        </Button.Styles>
        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Width="10" Height="10" Foreground="#8B949E"/>
    </Button>
</Grid>
</UserControl>
