  it under the terms of the GNU General Public License as published by
  the Free Software Foundation, either version 3 of the License, or
  (at your option) any later version.

  This program is distributed in the hope that it will be useful,
  but WITHOUT ANY WARRANTY; without even the implied warranty of
  MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
  GNU General Public License for more details.

  You should have received a copy of the GNU General Public License
  along with this program.  If not, see <https://www.gnu.org/licenses/>.
-->

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:overlays="clr-namespace:CrimsonOnion.Views.Overlays"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrimsonOnion"
        mc:Ignorable="d" d:DesignWidth="780" d:DesignHeight="780"
        x:Class="CrimsonOnion.MainWindow"
        x:DataType="local:MainWindow"
        Title="CrimsonOnion" Width="780" SizeToContent="Height"
        Icon="avares://CrimsonOnion/Assets/icon.ico"
        WindowDecorations="None" WindowStartupLocation="CenterScreen"
        Background="Transparent" TransparencyLevelHint="Transparent" 
        Foreground="#E2E8F0" FontFamily="Segoe UI" ToolTip.ShowDelay="1500" ToolTip.BetweenShowDelay="0">

    <Window.Resources>
        <LinearGradientBrush x:Key="ThemeCrimsonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4A0811" Offset="0"/>
            <GradientStop Color="#B82E42" Offset="0.5"/>
            <GradientStop Color="#FF6B83" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeBlueBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1A365D" Offset="0"/>
            <GradientStop Color="#3182CE" Offset="0.5"/>
            <GradientStop Color="#90CDF4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemePurpleBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#44337A" Offset="0"/>
            <GradientStop Color="#805AD5" Offset="0.5"/>
            <GradientStop Color="#D6BCFA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeGreenBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#1C4532" Offset="0"/>
            <GradientStop Color="#38A169" Offset="0.5"/>
            <GradientStop Color="#9AE6B4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemePinkBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#702459" Offset="0"/>
            <GradientStop Color="#D53F8C" Offset="0.5"/>
            <GradientStop Color="#FBB6CE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeYellowBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#744210" Offset="0"/>
            <GradientStop Color="#D69E2E" Offset="0.5"/>
            <GradientStop Color="#FEFCBF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeAllBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#FF6B83" Offset="0"/>
            <GradientStop Color="#805AD5" Offset="0.5"/>
            <GradientStop Color="#3182CE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ThemeCurrentBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#4A0811" Offset="0"/>
            <GradientStop Color="#E53E3E" Offset="0.5"/>
            <GradientStop Color="#FEB2B2" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.ThemeColorButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
                <Style Selector="Rectangle.rectGradient">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover Rectangle.rectGradient">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="Rectangle.solidHover">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover Rectangle.solidHover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="ComboBox /template/ Popup > Border">
            <Style.Animations>
                <Animation Duration="0:0:0.2" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="-10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Button.windowControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.windowControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Button.closeControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.countryControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D3136"/>
        </Style>
        <Style Selector="Button.connectBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.modeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.modeBtn:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.modeBtn:disabled TextBlock.modeText">
            <Setter Property="Foreground" Value="#8B949E"/>
        </Style>
        <Style Selector="TextBlock.modeText">
            <Setter Property="Foreground" Value="#8B949E"/>
        </Style>
        <Style Selector="Button.activeMode TextBlock.modeText">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.modeBtn:pointerover TextBlock.modeText">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>
        <Style Selector="Button.sidebarControl">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Padding" Value="0,12,0,12"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.sidebarControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2D3136"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>

        <Style Selector="Border.sidebar">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar:pointerover">
            <Setter Property="Width" Value="175"/>
        </Style>

        <Style Selector="Border.sidebar TextBlock.sidebarText">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.sidebar:pointerover TextBlock.sidebarText">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBlock.settingTitle">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.settingTitle:pointerover">
            <Setter Property="Foreground" Value="#E2E8F0"/>
        </Style>

        <Style Selector="Border.popupContent">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateY(-10px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.popupContent.popupOpen">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>

        <Style Selector="Button.optBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Padding" Value="8,4,8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.optBtn:pointerover">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button.optBtn.activeOpt">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>

        <Style Selector="TextBlock.portHoverText">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.portHoverText:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="TextBlock.statHoverText">
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.statHoverText:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Button.graphHover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.graphHover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
    </Window.Styles>

    <Border CornerRadius="8" ClipToBounds="True" Background="#0A0C0F" BorderBrush="#2D3748" BorderThickness="1">
        <Grid>
            <Canvas Height="0" IsHitTestVisible="False">
                <Ellipse x:Name="bgGlowEllipse" Width="1400" Height="1400" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-350,0,0" IsHitTestVisible="False" Opacity="0.7">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{DynamicResource ThemeGlow}">
                            <SolidColorBrush.Transitions>
                                <Transitions>
                                    <ColorTransition Property="Color" Duration="0:0:0.8" Easing="CubicEaseOut"/>
                                </Transitions>
                            </SolidColorBrush.Transitions>
                        </SolidColorBrush>
                    </Ellipse.Fill>
                    <Ellipse.OpacityMask>
                        <RadialGradientBrush GradientOrigin="50%,50%" Center="50%,50%" RadiusX="50%" RadiusY="50%">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.OpacityMask>

                    <Ellipse.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <Grid RowDefinitions="45, *">

                  <Grid Grid.Row="0" Background="#110A0C0F" PointerPressed="TitleBar_PointerPressed">

                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False">
                          <Image Source="avares://CrimsonOnion/Assets/icon.ico" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                          <TextBlock Text="CrimsonOnion" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="16" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                      </StackPanel>

                      <Button Name="btnTitleUpdate" Content="NEW UPDATE AVAILABLE" IsVisible="False"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="Transparent" Foreground="{DynamicResource ThemeGlowBrush}" FontWeight="Bold" FontSize="12"
                              Cursor="Hand" BorderThickness="0" Click="BtnTitleUpdate_Click"/>

                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                          <Button Classes="windowControl" Click="BtnCrimsonXPromo_Click" ToolTip.Tip="Discover CrimsonX">
                              <Image Source="avares://CrimsonOnion/Assets/CrimsonX.ico" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                          </Button>
                          <Button Classes="windowControl" Content="&#x2013;" FontSize="14" Click="Minimize_Click"/>
                          <Button Classes="windowControl closeControl" Content="&#x2715;" FontSize="12" Click="Close_Click"/>
                      </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto, *">

                    <overlays:SidebarOverlay x:Name="ucSidebar" ZIndex="500"/>

                    <Grid x:Name="panMainInteraction" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,20,0,0">
                        <Grid RowDefinitions="Auto, Auto, Auto">

                            <Button x:Name="btnCurrentCountry" Grid.Row="0" Background="Transparent" BorderThickness="0" CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,10" Padding="15,8,15,8" Cursor="Hand" Click="MainCountries_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon x:Name="iconCurrentRouting" Data="M7 2v11h3v9l7-12h-4l4-8z" Width="14" Height="14" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtCurrentRouting" Text="OPTIMIZED" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center"/>
                                    <PathIcon Data="M7 10l5 5 5-5z" Width="10" Height="10" Foreground="#8B949E" VerticalAlignment="Center" Margin="2,2,0,0"/>
                                </StackPanel>
                            </Button>

                              <Panel Grid.Row="1" HorizontalAlignment="Center">
                                  <Border x:Name="panConnectGlow" CornerRadius="13" ClipToBounds="True" Opacity="0" Margin="-2">
                                      <Border.Transitions>
                                          <Transitions>
                                              <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                                          </Transitions>
                                      </Border.Transitions>
                                      <Panel>
                                          <Panel x:Name="panOuterGlow" HorizontalAlignment="Center" VerticalAlignment="Center">
                                              <Rectangle x:Name="rectOuterGlow" Classes="animGlow" Width="800" Height="800" Margin="-400">
                                                  <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                                                  <Rectangle.Fill>
                                                      <ConicGradientBrush Center="50%,50%" Angle="0">
                                                          <GradientStop Color="#00000000" Offset="0"/>
                                                          <GradientStop Color="{DynamicResource ThemeGlow}" Offset="0.1"/>
                                                          <GradientStop Color="#00000000" Offset="0.15"/>
                                                          <GradientStop Color="#00000000" Offset="0.5"/>
                                                          <GradientStop Color="{DynamicResource ThemeGlow}" Offset="0.6"/>
                                                          <GradientStop Color="#00000000" Offset="0.65"/>
                                                      </ConicGradientBrush>
                                                  </Rectangle.Fill>
                                                  <Rectangle.Styles>

                                                  </Rectangle.Styles>
                                              </Rectangle>
                                          </Panel>

                                          <Border Margin="2" CornerRadius="12" Background="#0A0C0F" />
                                      </Panel>
                                  </Border>

                                  <Border x:Name="panConnectBox" Background="#99141414" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Padding="3">
                                      <Grid RowDefinitions="Auto, Auto">

                                            <Button x:Name="btnConnect" Grid.Row="0" Classes="connectBtn" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="0" Cursor="Hand" Margin="2,2,2,2" Click="btnConnect_Click">
                                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Main Text (CONNECT / CONNECTING) -->
                                                    <TextBlock x:Name="txtConnectBtn" Text="CONNECT" FontSize="19" FontWeight="Bold" LetterSpacing="2" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,8">
                                                        <TextBlock.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                                                            </Transitions>
                                                        </TextBlock.Transitions>
                                                    </TextBlock>

                                                    <!-- Success Text (CONNECTED) -->
                                                    <TextBlock x:Name="txtConnectedBtn" Text="CONNECTED" FontSize="19" FontWeight="Bold" LetterSpacing="2" Foreground="{DynamicResource ThemeGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,8" Opacity="0" IsHitTestVisible="False">
                                                        <TextBlock.Transitions>
                                                            <Transitions>
                                                                <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut"/>
                                                            </Transitions>
                                                        </TextBlock.Transitions>
                                                    </TextBlock>
                                                </Grid>
                                            </Button>

                                          <Grid Grid.Row="1" ColumnDefinitions="Auto, Auto, Auto, Auto, Auto" Margin="0">
                                              <Button x:Name="btnProxyMode" Grid.Column="0" Classes="modeBtn activeMode" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,8,14,8" Margin="2,2,2,2" Cursor="Hand" Click="Mode_Click" >
                                                  <TextBlock x:Name="lblProxyMode" Classes="modeText" Text="PROXY MODE" FontSize="11" FontWeight="SemiBold"/>
                                              </Button>

                                              <Border Grid.Column="1" Width="1" Background="#2D3748" Margin="0,6,0,6"/>

                                              <Panel x:Name="panVpnMode" Grid.Column="2" Background="Transparent" Margin="2,2,2,2">
                                                  <Button x:Name="btnVpnMode" Classes="modeBtn" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,8,14,8" Cursor="Hand" Click="Mode_Click" >
                                                      <TextBlock x:Name="lblVpnMode" Classes="modeText" Text="VPN MODE" FontSize="11" FontWeight="SemiBold"/>
                                                  </Button>
                                              </Panel>

                                              <Border Grid.Column="3" Width="1" Background="#2D3748" Margin="0,6,0,6"/>

                                              <Button x:Name="btnClearProxy" Grid.Column="4" Classes="modeBtn" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="14,8,14,8" Margin="2,2,2,2" Cursor="Hand" Click="Mode_Click" >
                                                  <TextBlock x:Name="lblClearProxy" Classes="modeText" Text="CLEAR PROXY" FontSize="11" FontWeight="SemiBold"/>
                                              </Button>
                                          </Grid>
                                      </Grid>
                                  </Border>
                              </Panel>

                            <Border x:Name="panAdvancedBridges" Grid.Row="2" Width="{Binding Bounds.Width, ElementName=panConnectBox}" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#99141414" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="2,2" Margin="0,9,0,0" Opacity="0" IsHitTestVisible="False">
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseInOut"/>
                                    </Transitions>
                                </Border.Transitions>
                                <Border.Styles>
                                    <Style Selector="Button.advBtn">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="RenderTransform" Value="scale(1.0)"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button.advBtn:pressed">
                                        <Setter Property="RenderTransform" Value="scale(0.96)"/>
                                    </Style>
                                    <Style Selector="Button.advBtn TextBlock.advText">
                                        <Setter Property="Foreground" Value="#8B949E"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="Button.advBtn:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="Button.advBtn:pointerover TextBlock.advText">
                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                    </Style>
                                    <Style Selector="Button.activeMode TextBlock.advText">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Style>
                                    <Style Selector="Button.notrans TextBlock.advText">
                                        <Setter Property="Transitions" Value="{x:Null}"/>
                                    </Style>
                                </Border.Styles>
                                <Grid ColumnDefinitions="*, *" HorizontalAlignment="Stretch">
                                    <Button x:Name="btnAmpCacheMode" Grid.Column="0" Grid.ColumnSpan="2" Classes="advBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="0,6" Cursor="Hand" Click="AdvancedBridgeMode_Click">
                                        <TextBlock x:Name="lblAmpCache" Classes="advText" Text="AMP CACHE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="btnDnsRegMode" Grid.Column="1" Classes="advBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="6" Padding="0,6" Cursor="Hand" Click="AdvancedBridgeMode_Click" IsVisible="False">
                                        <TextBlock x:Name="lblDnsReg" Classes="advText" Text="DNS REGISTRATION" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Border x:Name="panDnsRegDiv" Grid.Column="0" Grid.ColumnSpan="2" Width="1" Background="#2D3748" Margin="0,6,0,6" HorizontalAlignment="Center" IsVisible="False" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <Border x:Name="panMainConfig" Grid.Row="2" Background="#99141414" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Padding="6" Margin="10,50,25,15" HorizontalAlignment="Stretch">
                                <StackPanel Spacing="6">

                                    <Border Background="#400A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto, *, Auto" MinHeight="36">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <PathIcon Data="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" Width="14" Height="14" Foreground="#8B949E"/>
                                                    <TextBlock x:Name="lblBridgeType" Text="BRIDGE TYPE" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="15,0,0,0">
                                                    <Button x:Name="btnBridgeDirect" Classes="optBtn activeOpt" Click="Bridge_Click"><TextBlock Text="DIRECT" FontSize="11" FontWeight="SemiBold"/></Button>
                                                    <Button x:Name="btnBridgeObfs4" Classes="optBtn" Click="Bridge_Click"><TextBlock Text="OBFS4" FontSize="11" FontWeight="SemiBold"/></Button>
                                                    <Button x:Name="btnBridgeSnowflake" Classes="optBtn" Click="Bridge_Click"><TextBlock Text="SNOWFLAKE" FontSize="11" FontWeight="SemiBold"/></Button>
                                                    <Button x:Name="btnBridgeMeek" Classes="optBtn" Click="Bridge_Click"><TextBlock Text="MEEK" FontSize="11" FontWeight="SemiBold"/></Button>
                                                    <Button x:Name="btnBridgeConjure" Classes="optBtn" Click="Bridge_Click"><TextBlock Text="CONJURE" FontSize="11" FontWeight="SemiBold"/></Button>
                                                    <Button x:Name="btnBridgeCustom" Classes="optBtn" Click="Bridge_Click"><TextBlock Text="CUSTOM" FontSize="11" FontWeight="SemiBold"/></Button>
                                                </StackPanel>
                                            </Grid>

                                            <Border x:Name="panCustomBridge" Background="Transparent" BorderThickness="0" ClipToBounds="True" MaxHeight="0" Opacity="0">
                                                <Border.Transitions>
                                                    <Transitions>
                                                        <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                    </Transitions>
                                                </Border.Transitions>
                                                <StackPanel Spacing="6" Margin="0,8,0,0">
                                            <Grid ColumnDefinitions="*, Auto, 140" Height="110" Margin="0,0,0,6">
                                                <TextBox x:Name="txtCustomBridge" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap" Background="#1A1C20" Foreground="{DynamicResource ThemeGlowBrush}" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="11" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Stretch"/>

                                                <Border x:Name="panCaptcha" Grid.Column="1" Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Padding="2" MaxHeight="0" MaxWidth="0" Opacity="0" ClipToBounds="True" Margin="0,0,0,0" VerticalAlignment="Stretch">
                                                    <Border.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                            <DoubleTransition Property="MaxWidth" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                            <ThicknessTransition Property="Margin" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                        </Transitions>
                                                    </Border.Transitions>
                                                    <Grid Width="140">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="26"/>
                                                        </Grid.RowDefinitions>
                                                        <Image x:Name="imgCaptcha" Grid.Row="0" Height="40" Stretch="Uniform" Margin="0,0,0,6"/>
                                                        <TextBox x:Name="txtCaptchaSol" KeyDown="txtCaptchaSol_KeyDown" Grid.Row="1" MinHeight="20" PlaceholderText="ENTER CAPTCHA" Background="#0A0C0F" Foreground="#E2E8F0" BorderBrush="#3A3F44" BorderThickness="1" Padding="0" FontFamily="Consolas" FontSize="10" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="1.5,0,1.5,6" VerticalAlignment="Stretch"/>
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
                                                            <Button x:Name="btnCaptchaSubmit" Click="btnCaptchaSubmit_Click" Grid.Column="0" Content="SUBMIT" FontSize="9" FontWeight="Bold" Background="#4E7A5E" Foreground="#FFF" CornerRadius="3" Margin="1.5" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                            <Button x:Name="btnCaptchaCancel" Click="btnCaptchaCancel_Click" Grid.Column="2" Content="CANCEL" FontSize="9" FontWeight="Bold" Background="#8B4A4A" Foreground="#FFF" CornerRadius="3" Margin="1.5" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center"/>
                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                                <Grid Grid.Column="2" Margin="0,0,0,0">
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Width="140" Background="#1A1C20" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="26"/>
                                                                <RowDefinition Height="1"/>
                                                                <RowDefinition Height="26"/>
                                                                <RowDefinition Height="1"/>
                                                                <RowDefinition Height="26"/>
                                                                <RowDefinition Height="1"/>
                                                                <RowDefinition Height="26"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock x:Name="lblGetBridges" Grid.Row="0" Text="GET BRIDGES" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                            <Border Grid.Row="1" Background="#2D3748"/>

                                                            <Button x:Name="btnGetWebTunnel" Click="btnGetWebTunnel_Click" Grid.Row="2" Content="WEBTUNNEL" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Cursor="Hand" BorderThickness="0" CornerRadius="0">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                            </Button>
                                                            <Border Grid.Row="3" Background="#2D3748"/>

                                                            <Button x:Name="btnGetObfs4" Click="btnGetObfs4_Click" Grid.Row="4" Content="OBFS4" FontSize="10" FontWeight="Bold" Foreground="#E2E8F0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Cursor="Hand" BorderThickness="0" CornerRadius="0">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                        <Setter Property="Background" Value="#25FFFFFF"/>
                                                                    </Style>
                                                                </Button.Styles>
                                                            </Button>
                                                            <Border Grid.Row="5" Background="#2D3748"/>

                                                            <Border Grid.Row="6" Background="#0A0C0F" CornerRadius="0,0,3,3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="1"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button x:Name="btnCustomSave" Click="btnCustomSave_Click" Grid.Column="0" Content="SAVE" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Cursor="Hand" BorderThickness="0" CornerRadius="0">
                                                                        <Button.Styles>
                                                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                            </Style>
                                                                        </Button.Styles>
                                                                    </Button>
                                                                    <Border Grid.Column="1" Background="#2D3748"/>
                                                                    <Button x:Name="btnCustomCancel" Click="btnCustomCancel_Click" Grid.Column="2" Content="CANCEL" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" Cursor="Hand" BorderThickness="0" CornerRadius="0">
                                                                        <Button.Styles>
                                                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                                                <Setter Property="Background" Value="#2AFFFFFF"/>
                                                                            </Style>
                                                                        </Button.Styles>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#400A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <Grid ColumnDefinitions="Auto, *, Auto" MinHeight="36">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <PathIcon Data="M20 13H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zm0-10H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 19c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM7 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" Width="14" Height="14" Foreground="#8B949E"/>
                                                <TextBlock x:Name="lblTorEngines" Text="TOR ENGINES" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="15,0,0,0">
                                                <Slider x:Name="sldEngines" Minimum="1" Maximum="8" Value="1" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" Margin="0,-12,0,-12" VerticalAlignment="Center" ValueChanged="Engines_ValueChanged" Foreground="{DynamicResource ThemeGlowBrush}">
                                                    <Slider.Styles>
                                                        <Style Selector="Slider /template/ Thumb">
                                                            <Setter Property="Template">
                                                                <ControlTemplate>
                                                                    <Border Background="{DynamicResource ThemeAccent}" Width="24" Height="10" CornerRadius="4" />
                                                                </ControlTemplate>
                                                            </Setter>
                                                        </Style>
                                                        <Style Selector="Slider:pointerover /template/ Thumb">
                                                            <Setter Property="Template">
                                                                <ControlTemplate>
                                                                    <Border Background="{DynamicResource ThemeAccentPointerOver}" Width="24" Height="10" CornerRadius="4" />
                                                                </ControlTemplate>
                                                            </Setter>
                                                        </Style>
                                                    </Slider.Styles>
                                                </Slider>
                                                <TextBlock x:Name="lblEngineCount" Text="1" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                      <Border Background="#400A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="Auto, *, Auto" MinHeight="36">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <PathIcon Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" Width="14" Height="14" Foreground="#8B949E"/>
                                                    <TextBlock x:Name="lblLogsStatus" Text="LOGS &amp; STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#8B949E" LetterSpacing="1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="15,0,0,0">
                                                    <ToggleSwitch x:Name="chkLogs" IsCheckedChanged="chkLogs_CheckedChanged" OnContent="{x:Null}" OffContent="{x:Null}" FontSize="11" Foreground="#8B949E"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border x:Name="panLogs" Background="Transparent" BorderThickness="0" ClipToBounds="True" MaxHeight="0" Opacity="0">
                                        <Border.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="MaxHeight" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                            </Transitions>
                                        </Border.Transitions>
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,5,0,0">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="lblTorBootstrap" Text="TOR BOOTSTRAP" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,5"/>
                                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="95,95" Height="100">
                                                    <TextBlock x:Name="lblTor1" Grid.Row="0" Grid.Column="0" Text="TOR 01: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor2" Grid.Row="1" Grid.Column="0" Text="TOR 02: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor3" Grid.Row="2" Grid.Column="0" Text="TOR 03: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor4" Grid.Row="3" Grid.Column="0" Text="TOR 04: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor5" Grid.Row="0" Grid.Column="1" Text="TOR 05: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor6" Grid.Row="1" Grid.Column="1" Text="TOR 06: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor7" Grid.Row="2" Grid.Column="1" Text="TOR 07: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="lblTor8" Grid.Row="3" Grid.Column="1" Text="TOR 08: DISABLED" FontSize="10" Foreground="#A0AEC0" Opacity="0.5" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="25,0,0,0">
                                                <TextBlock x:Name="lblXrayLogHeader" Text="CONNECTIONS (XRAY LOG)" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,5"/>
                                                <TextBox x:Name="txtXrayLogs" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Background="#1A1C20" Foreground="{DynamicResource ThemeGlowBrush}" BorderBrush="#2D3748" BorderThickness="1" FontFamily="Consolas" FontSize="10" CornerRadius="4" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </Grid>
                                            </Border>
                                          </StackPanel>
                                      </Border>

                                      <Border Background="#400A0C0F" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="8" Padding="8">
                                          <StackPanel>
                                                <Border x:Name="panStats" Background="Transparent" BorderThickness="0">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Grid x:Name="panLeftStats" Grid.Column="0" RowDefinitions="Auto, *">
                                                            <Grid.Transitions>
                                                                <Transitions>
                                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                                </Transitions>
                                                            </Grid.Transitions>

                                                            <Grid ColumnDefinitions="Auto, 4, Auto" RowDefinitions="Auto, Auto" Margin="0,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                <Button Grid.Row="0" Grid.Column="0" Classes="graphHover" Background="Transparent" BorderThickness="0" Padding="5,4" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="lblSessionLabel" Text="SESSION:" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,2"/>
                                                                        <TextBlock x:Name="lblTimer" Text="Disconnected" FontSize="11" FontWeight="Bold" FontFamily="Consolas" LineHeight="13" Classes="statHoverText"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Row="0" Grid.Column="2" Classes="graphHover" Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="lblLocalPortLabel" Text="LOCAL PORT:" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,2"/>
                                                                        <TextBlock x:Name="lblLocalIp" FontSize="11" FontWeight="Bold" FontFamily="Consolas" LineHeight="13" Classes="portHoverText" PointerPressed="CopyIp_PointerPressed" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button x:Name="btnLocation" Grid.Row="1" Grid.Column="0" Classes="graphHover" Background="Transparent" BorderThickness="0" Padding="5,4" Cursor="Hand" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="RefreshLocation_Click" ToolTip.Tip="Click to refresh location and ping">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="lblLocationLabel" Text="LOCATION:" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,2"/>
                                                                        <TextBlock x:Name="lblCountryName" Text="Disconnected" FontSize="11" FontWeight="Bold" FontFamily="Consolas" LineHeight="13" Classes="statHoverText"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Grid.Row="1" Grid.Column="2" Classes="graphHover" Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand" CornerRadius="4" VerticalAlignment="Top" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="lblLanPortLabel" Text="LAN PORT:" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" Margin="0,0,0,2"/>
                                                                        <TextBlock x:Name="lblLanIp" FontSize="11" FontWeight="Bold" FontFamily="Consolas" LineHeight="13" Classes="portHoverText" PointerPressed="CopyIp_PointerPressed" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>

                                                        <Button x:Name="btnRefreshPing" Grid.Column="1" Classes="graphHover" Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand" Click="RefreshPing_Click" VerticalAlignment="Top" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch">
                                                            <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="5,0,5,0" VerticalAlignment="Center">

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8" Margin="0,0,15,0">
                                                                    <StackPanel HorizontalAlignment="Left">
                                                                        <TextBlock x:Name="lblPingLabel" Text="PING" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"/>
                                                                        <TextBlock x:Name="lblPing" Text="0 ms" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#8B949E" Margin="0,2,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel HorizontalAlignment="Left">
                                                                        <TextBlock x:Name="lblTotalLabel" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0"/>
                                                                        <TextBlock x:Name="lblTotalData" Text="0 MB" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#8B949E" Margin="0,2,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="0,0,10,0">
                                                                    <StackPanel HorizontalAlignment="Left">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <Rectangle Width="8" Height="2" Fill="#A0AEC0" VerticalAlignment="Center" RadiusX="1" RadiusY="1"/>
                                                                            <TextBlock x:Name="lblDownloadLabel" Text="DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <TextBlock x:Name="lblDownloadSpeed" Text="0 KB/s" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#8B949E" Margin="12,2,0,0"/>
                                                                    </StackPanel>

                                                                    <StackPanel HorizontalAlignment="Left">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                            <Rectangle Width="8" Height="1" Fill="#718096" VerticalAlignment="Center" RadiusX="0.5" RadiusY="0.5"/>
                                                                            <TextBlock x:Name="lblUploadLabel" Text="UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#A0AEC0" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <TextBlock x:Name="lblUploadSpeed" Text="0 KB/s" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="#8B949E" Margin="12,2,0,0"/>
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <Grid Grid.Column="2" Width="150" Height="40" ClipToBounds="True" VerticalAlignment="Center">
                                                                    <Grid.OpacityMask>
                                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                            <GradientStop Color="#00000000" Offset="0"/>
                                                                            <GradientStop Color="#FFFFFFFF" Offset="0.15"/>
                                                                            <GradientStop Color="#FFFFFFFF" Offset="0.85"/>
                                                                            <GradientStop Color="#00000000" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Grid.OpacityMask>

                                                                    <Canvas x:Name="graphCanvas" Width="150" Height="40" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                        <Canvas.RenderTransform>
                                                                            <TranslateTransform X="0"/>
                                                                        </Canvas.RenderTransform>

                                                                        <Path x:Name="graphDownloadFill" Fill="#2A8B949E" />
                                                                        <Path x:Name="graphUploadFill" Fill="#1A718096" />
                                                                        <Path x:Name="graphUpload" Stroke="#718096" StrokeThickness="1" />
                                                                        <Path x:Name="graphDownload" Stroke="#A0AEC0" StrokeThickness="2" StrokeJoin="Round" />
                                                                    </Canvas>
                                                                </Grid>
                                                            </Grid>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                          </StackPanel>
                                      </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border x:Name="panExpertOverlay" Classes="popupContent" Grid.Column="1" Background="#101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Margin="-5,10,25,15" ZIndex="400" IsVisible="False" Padding="30,20,30,10" VerticalAlignment="Top"  BoxShadow="0 0 50 1000 #B3000000">
                        <overlays:ExpertOverlay x:Name="ucExpert"/>
                    </Border>

                    <Border x:Name="panThemesOverlay" Classes="popupContent" Grid.Column="1" Background="#101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Margin="-5,10,25,15" ZIndex="400" IsVisible="False" Padding="0" VerticalAlignment="Top" MaxHeight="460" BoxShadow="0 0 50 1000 #B3000000">
                          <overlays:ThemesOverlay x:Name="ucThemes" />
                      </Border>

                      <Border x:Name="panSettingsOverlay" Classes="popupContent" Grid.Column="1" Background="#F2101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Margin="-5,10,25,15" ZIndex="400" IsVisible="False" Padding="0" VerticalAlignment="Top" MaxHeight="460" BoxShadow="0 0 50 1000 #B3000000">
                          <overlays:SettingsOverlay x:Name="ucSettings" />
                      </Border>

<Border x:Name="panSplitOverlay" Classes="popupContent" Grid.Column="1" Background="#101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Margin="-5,10,25,15" ZIndex="400" IsVisible="False" Padding="0" VerticalAlignment="Top" MaxHeight="460" BoxShadow="0 0 50 1000 #B3000000">
    <overlays:SplitTunnelOverlay x:Name="ucSplitTunnel" />
</Border>

                      <Border x:Name="panAboutOverlay" Classes="popupContent" Grid.Column="1" Background="#101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Margin="-5,10,25,15" ZIndex="400" IsVisible="False" Padding="0" VerticalAlignment="Top" MaxHeight="460" BoxShadow="0 0 50 1000 #B3000000">
                          <overlays:AboutOverlay x:Name="ucAbout" />
                      </Border>

                    <Border x:Name="LightDismissOverlay" Grid.ColumnSpan="2" Background="#01000000" IsVisible="False" PointerPressed="LightDismissOverlay_PointerPressed" ZIndex="200"/>

                    <Popup x:Name="LanguagePopup" IsLightDismissEnabled="False">
                        <Border Classes="popupContent" Background="#E6101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="90" Padding="2">
                            <StackPanel>
                                <Button Classes="countryControl" Tag="ENGLISH" Click="LanguageOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4">
                                    <TextBlock Text="ENGLISH" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                                <Button Classes="countryControl" Tag="PERSIAN" Click="LanguageOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4">
                                    <TextBlock Text="PERSIAN" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="LbPolicyPopup" IsLightDismissEnabled="False">
                        <Border Classes="popupContent" Background="#E6101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="4" Width="137" Padding="2">
                            <StackPanel>
                                <Button x:Name="btnLbLeastLoad" Classes="countryControl" Tag="leastload" Click="LbPolicyOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4" ToolTip.Tip="Distributes each new connection to the least-loaded Tor instance. Best for mixed traffic with varying connection size.">
                                    <TextBlock Text="LEAST LOAD" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                                <Button x:Name="btnLbRoundRobin" Classes="countryControl" Tag="roundrobin" Click="LbPolicyOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4" ToolTip.Tip="Distributes connections evenly across all Tor instances in order, cycling through them one by one. Good for consistent, equal distribution.">
                                    <TextBlock Text="ROUND ROBIN" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                                <Button x:Name="btnLbLeastPing" Classes="countryControl" Tag="leastping" Click="LbPolicyOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4" ToolTip.Tip="Picks the Tor instance with the lowest recent ping. Best for latency-sensitive traffic.">
                                    <TextBlock Text="LEAST PING" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                                <Button x:Name="btnLbRandom" Classes="countryControl" Tag="random" Click="LbPolicyOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="8,6" Cursor="Hand" CornerRadius="4" ToolTip.Tip="Picks a Tor instance at random for each new connection. Statistically even over time but with more variance than Round Robin.">
                                    <TextBlock Text="RANDOM" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="CountriesPopup" IsLightDismissEnabled="False">
                        <Border Classes="popupContent" Background="#E6101116" BorderBrush="#2D3748" BorderThickness="1" CornerRadius="12" Width="260" MaxHeight="425" Padding="5">
                        <ScrollViewer>
                            <StackPanel>

                                    <Button Classes="countryControl" Tag="Optimized" Click="RoutingOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="15,10" Cursor="Hand" CornerRadius="8" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal" Spacing="15">
                                            <Border Width="24" Height="16">
                                                <PathIcon Data="M7 2v11h3v9l7-12h-4l4-8z" Width="14" Height="14" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="lblCountriesOptimized" Text="OPTIMIZED" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="countryControl" Tag="Expert" Click="RoutingOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="15,10" Cursor="Hand" CornerRadius="8" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal" Spacing="15">
                                            <Border Width="24" Height="16">
                                                <PathIcon Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z" Width="16" Height="16" Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="lblCountriesExpert" Text="EXPERT" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="#2D3748" Margin="15,5,20,5" />

                                    <ItemsControl ItemsSource="{Binding Countries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:CountryItem">
                                                <Button Classes="countryControl" Tag="{Binding Tag}" Click="RoutingOption_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="15,10" Cursor="Hand" CornerRadius="8" Margin="0,0,5,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                                        <Image Source="{Binding Flag}" Width="24" Height="16" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>

                </Grid>

                <Border x:Name="ToastBorder"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,15,0,0"
                        ZIndex="1000"
                        Background="#E6101116"
                        BorderBrush="#2D3748"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="18,12,18,12"
                        IsHitTestVisible="False">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                        </Transitions>
                    </Border.Transitions>
                    <TextBlock x:Name="ToastText"
                               Text=""
                               FontSize="12"
                               FontWeight="Bold"
                               LetterSpacing="1"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="350"
                               HorizontalAlignment="Center"/>
                </Border>

            </Grid>

        </Grid>
    </Border>
</Window>
